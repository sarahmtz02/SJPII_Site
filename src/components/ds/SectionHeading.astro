---
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  align?: 'left' | 'center';
  inverse?: boolean;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { eyebrow, title, lead, align = 'left', inverse = false, size = 'md', class: className } = Astro.props;
---
<div class:list={['sh', `sh--${align}`, `sh--${size}`, { 'sh--inverse': inverse }, className]}>
  {eyebrow && (
    <div class="sh__eyebrow"><span class="sh__rule" />{eyebrow}</div>
  )}
  {title && <h2 class="sh__title">{title}</h2>}
  {lead && <p class="sh__lead">{lead}</p>}
</div>

<style>
  .sh { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; text-align: left; max-width: 720px; margin: 0; }
  .sh--center { align-items: center; text-align: center; max-width: 760px; margin: 0 auto; }

  .sh__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-accent);
  }
  .sh__rule { width: 24px; height: 1px; background: currentColor; }

  .sh__title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-h2);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text-heading);
    text-wrap: balance;
  }
  .sh--sm .sh__title { font-size: var(--text-h3); }
  .sh--lg .sh__title { font-size: var(--text-h1); }
  .sh--xl .sh__title { font-size: var(--text-display); line-height: var(--leading-tight); }

  .sh__lead {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-lead);
    line-height: var(--leading-body);
    font-weight: 300;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .sh--inverse .sh__eyebrow { color: var(--text-accent-on-inverse); }
  .sh--inverse .sh__title { color: var(--text-on-inverse); }
  .sh--inverse .sh__lead { color: var(--text-on-inverse-muted); }
</style>
