---
import Button from './ds/Button.astro';
import IconButton from './ds/IconButton.astro';
import Icon from './ds/Icon.astro';
import { nav, routes, type PageId } from '../data/site';

interface Props {
  active?: PageId;
  /** Transparent header laid over a full-bleed hero photo. */
  overHero?: boolean;
}

const { active, overHero = false } = Astro.props;
const desktopLinks = nav.slice(0, 6);
---
<header class:list={['site-header', { 'site-header--clear': overHero }]}>
  <a href={routes.inicio} aria-label="Inicio" class="site-header__brand">
    <img src="/assets/logo-psjpii.png" alt="Parroquia San Juan Pablo II, Corregidora, Qro." width="122" height="50" />
  </a>

  <nav class="site-header__nav" aria-label="Principal">
    {desktopLinks.map((l) => (
      <a href={routes[l.id]} class:list={['site-header__link', { 'is-active': l.id === active }]} aria-current={l.id === active ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
  </nav>
  <div class="site-header__actions">
    <Button variant={overHero ? 'inverse' : 'secondary'} size="sm" href={routes.oracion}>Oración</Button>
    <Button variant="accent" size="sm" href={routes.donativos}>Donar</Button>
  </div>

  <div class="site-header__toggle">
    <IconButton icon="menu" label="Abrir menú" variant={overHero ? 'inverse' : 'ghost'} data-menu-open aria-controls="mobile-menu" aria-expanded="false" />
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <div class="mobile-menu__bar">
    <img src="/assets/logo-psjpii.png" alt="Parroquia San Juan Pablo II" width="122" height="50" />
    <IconButton icon="x" label="Cerrar menú" variant="inverse" data-menu-close />
  </div>
  <nav class="mobile-menu__nav" aria-label="Menú móvil">
    {nav.map((l) => (
      <a href={routes[l.id]} class:list={['mobile-menu__link', { 'is-active': l.id === active }]} aria-current={l.id === active ? 'page' : undefined}>
        <span>{l.label}</span>
        <Icon name="arrow-right" size={18} color="var(--gold-500)" />
      </a>
    ))}
  </nav>
  <div class="mobile-menu__ctas">
    <Button variant="accent" size="lg" fullWidth href={routes.donativos}>Donar</Button>
    <Button variant="inverse" size="lg" fullWidth href={routes.oracion}>Compartir una intención</Button>
  </div>
</div>

<script>
  const menu = document.getElementById('mobile-menu');
  const openBtn = document.querySelector<HTMLElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLElement>('[data-menu-close]');
  const desktop = window.matchMedia('(min-width: 1100px)');

  function setMenu(open: boolean) {
    if (!menu) return;
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    openBtn?.setAttribute('aria-expanded', String(open));
    if (open) closeBtn?.focus();
    else openBtn?.focus();
  }

  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setMenu(false);
  });
  desktop.addEventListener('change', (e) => {
    if (e.matches && menu && !menu.hidden) setMenu(false);
  });
</script>

<style>
  .site-header {
    --fg: var(--text-heading);
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--surface-page) 92%, transparent);
    backdrop-filter: var(--blur-header);
    -webkit-backdrop-filter: var(--blur-header);
    border-bottom: 1px solid var(--border-subtle);
  }
  .site-header--clear {
    --fg: #fff;
    position: absolute;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: rgba(255, 255, 255, .16);
  }

  .site-header__brand { display: flex; align-items: center; height: 100%; padding: 10px 0; flex: none; }
  .site-header__brand img { height: 50px; width: auto; display: block; }
  .site-header--clear .site-header__brand img { filter: invert(1); }

  .site-header__nav { display: none; gap: 26px; margin-left: auto; align-items: center; }
  .site-header__link {
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--fg);
    opacity: .78;
    padding: 6px 0 4px;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }
  .site-header__link:hover { color: var(--fg); opacity: 1; }
  .site-header__link.is-active { opacity: 1; border-bottom-color: var(--gold-500); }

  .site-header__actions { display: none; gap: 10px; align-items: center; }
  .site-header__toggle { margin-left: auto; display: flex; gap: 8px; align-items: center; }

  @media (min-width: 1100px) {
    .site-header__nav, .site-header__actions { display: flex; }
    .site-header__toggle { display: none; }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--navy-900);
    color: #fff;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(16px, 4vw, 40px);
    border-bottom: 1px solid var(--border-inverse);
    flex: none;
  }
  .mobile-menu__bar img { height: 50px; width: auto; filter: invert(1); }
  .mobile-menu__nav { display: flex; flex-direction: column; padding: 16px clamp(16px, 4vw, 40px); }
  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    border-bottom: 1px solid var(--border-inverse);
  }
  .mobile-menu__link:hover { color: var(--gold-400); }
  .mobile-menu__link.is-active { color: var(--gold-400); }
  .mobile-menu__ctas { display: flex; flex-direction: column; gap: 12px; padding: 24px clamp(16px, 4vw, 40px) 40px; margin-top: auto; }
</style>
