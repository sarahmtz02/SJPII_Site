---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { PageId } from '../data/site';

interface Props {
  title: string;
  description?: string;
  active?: PageId;
  /** Lay the header transparently over a full-bleed hero. */
  headerOverHero?: boolean;
}

const { title, description, active, headerOverHero = false } = Astro.props;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <div class="page">
      <SiteHeader active={active} overHero={headerOverHero} />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  .page { position: relative; min-height: 100vh; }
</style>
